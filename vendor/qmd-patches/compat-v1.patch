@@ -0,0 +1,63 @@
+/** dsearch compatibility boundary, pinned to the upstream and runtime in the release manifest. */
+import { AsyncLocalStorage } from "node:async_hooks";
+import { setImmediate } from "node:timers/promises";
+
+export class CompatibilityError extends Error {
+  constructor(public readonly code: string) { super(code); this.name = "CompatibilityError"; }
+}
+export class MemoryQueryCache {
+  private entries = new Map<string, { value: string; expires: number }>();
+  constructor(private readonly ttlMs = 300_000, private readonly maxEntries = 512) {}
+  get(key: string): string | null {
+    const hit = this.entries.get(key);
+    if (!hit || hit.expires <= Date.now()) { this.entries.delete(key); return null; }
+    return hit.value;
+  }
+  set(key: string, value: string): void {
+    if (this.entries.size >= this.maxEntries) this.entries.delete(this.entries.keys().next().value!);
+    this.entries.set(key, { value, expires: Date.now() + this.ttlMs });
+  }
+  delete(key: string): void { this.entries.delete(key); }
+  clear(): void { this.entries.clear(); }
+}
+export type CompatibilityStats = {
+  embeddingCalls: number; rerankingCalls: number; expansionCalls: number; actualCandidates: number;
+  memoryCacheReads: number; memoryCacheWrites: number; truncatedInputs: number;
+  rerankAttempted: boolean; rerankSucceeded: boolean;
+  fallbackUsed: boolean; embeddingTokensMax: number; rerankTokensMax: number;
+};
+export type CompatibilityRequest = {
+  signal?: AbortSignal; cache: MemoryQueryCache;
+  onProgress?: (event: { phase: string; completed: number }) => void;
+  stats: CompatibilityStats;
+};
+const requests = new AsyncLocalStorage<CompatibilityRequest>();
+export function currentCompatibility(): CompatibilityRequest | undefined { return requests.getStore(); }
+export function compatibilityStats(): CompatibilityStats {
+  return { embeddingCalls: 0, rerankingCalls: 0, expansionCalls: 0, actualCandidates: 0, memoryCacheReads: 0,
+    memoryCacheWrites: 0, truncatedInputs: 0, rerankAttempted: false, rerankSucceeded: false, fallbackUsed: false, embeddingTokensMax: 0, rerankTokensMax: 0 };
+}
+export function runDsearchRequest<T>(request: CompatibilityRequest, operation: () => Promise<T>): Promise<T> {
+  return requests.run(request, operation);
+}
+export function compatibilityCheck(): void {
+  if (currentCompatibility()?.signal?.aborted) throw new CompatibilityError("CANCELLED");
+}
+export async function compatibilityYield(phase: string, completed = 0): Promise<void> {
+  if (!currentCompatibility()) return;
+  await setImmediate();
+  compatibilityCheck();
+  currentCompatibility()?.onProgress?.({ phase, completed });
+}
+export function compatibilityTokens(count: number, kind: "document" | "query" | "rerank"): void {
+  const request = currentCompatibility(); if (!request) return;
+  const limit = kind === "query" ? 512 : kind === "document" ? 800 : 4096;
+  if (kind === "rerank") request.stats.rerankTokensMax = Math.max(request.stats.rerankTokensMax, count);
+  else request.stats.embeddingTokensMax = Math.max(request.stats.embeddingTokensMax, count);
+  if (count > limit) throw new CompatibilityError("INPUT_TOO_LONG");
+}
+export const dsearchCapabilities = Object.freeze({
+  version: 1, "EP-01": true, "EP-02": true, "EP-03": true, "EP-04": true,
+  runtime: "node-llama-cpp@3.20.0", cacheMode: "memory", strictNoTruncation: true,
+  sealedReadOnly: true,
+});
