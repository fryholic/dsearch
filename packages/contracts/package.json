{
  "name": "@dsearch/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "zod": "4.2.1"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./control": {"types":"./dist/control.d.ts","import":"./dist/control.js"},
    "./search": {"types":"./dist/search.d.ts","import":"./dist/search.js"},
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  }
}
